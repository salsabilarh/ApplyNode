generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobType {
  FULL_TIME
  FREELANCE
  PROJECT_BASED
  INTERNSHIP
  BOOTCAMP
  CONTRACT
  PART_TIME
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  jobs      Job[]    // Relasi ke tabel Job
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id               String     @id @default(cuid())
  userId           String     
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  position         String
  jobType          JobType    @default(FULL_TIME)
  company          String
  platform         String
  sourceLink       String?
  description      String?    @db.Text
  requirement      String?    @db.Text
  applyLink        String?
  duration         String?
  deadline         DateTime
  openingDate      DateTime?
  priority         Priority   @default(MEDIUM)
  
  status           JobStatus  @default(BACKLOG) // Diarahkan ke enum baru
  
  plannedApplyDate DateTime?
  plannedApplyTime String?
  appliedDate             DateTime?
  adminScreeningDate      DateTime?
  assessmentDate          DateTime?
  fgdLgdDate              DateTime?
  interviewHrDate         DateTime?
  interviewUserDate       DateTime?
  interviewExecutiveDate  DateTime?
  medicalCheckUpDate      DateTime?
  offeringDate            DateTime?
  closedDate              DateTime?
  applyNotes       String?    @db.Text
  notes            String?    @db.Text
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId])
  @@unique([userId, position, company, deadline])
}

// 2. HAPUS enum "Status" lama yang berisi 4 item, lalu gunakan versi lengkap ini:
enum JobStatus {
  BACKLOG
  APPLYING
  APPLIED
  ADMIN_SCREENING
  ASSESSMENT
  FGD_LGD
  INTERVIEW_HR
  INTERVIEW_USER
  INTERVIEW_EXECUTIVE
  MEDICAL_CHECK_UP
  OFFERING
  CLOSED
}